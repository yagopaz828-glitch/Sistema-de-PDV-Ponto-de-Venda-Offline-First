<div class="toast" id="toast"></div>
<script>
const seed=[
['7891000100103','Arroz tipo 1 5kg','Mercearia',27.90,24],['7891000100104','Feijão carioca 1kg','Mercearia',8.49,32],['7891000100105','Café tradicional 500g','Mercearia',16.90,18],['7891000100106','Açúcar refinado 1kg','Mercearia',4.79,40],['7891000100107','Macarrão espaguete 500g','Mercearia',5.49,29],['7891000100108','Óleo de soja 900ml','Mercearia',7.99,22],['7891000100109','Refrigerante cola 2L','Bebidas',9.99,21],['7891000100110','Água mineral 1,5L','Bebidas',3.50,50],['7891000100111','Suco integral 1L','Bebidas',12.90,14],['7891000100112','Sabonete 90g','Higiene',2.99,60],['7891000100113','Creme dental 90g','Higiene',5.49,27],['7891000100114','Detergente 500ml','Limpeza',2.79,42],['7891000100115','Amaciante 2L','Limpeza',14.90,16],['7891000100116','Queijo mussarela 300g','Frios',13.50,12],['7891000100117','Presunto fatiado 200g','Frios',8.90,9],['7891000100118','Papel higiênico 12un','Higiene',18.90,4]
].map((p,i)=>({id:i+1,code:p[0],name:p[1],category:p[2],price:p[3],stock:p[4]}));
const read=(k,d)=>{try{const v=localStorage.getItem('gestorpdv_'+k);return v?JSON.parse(v):d}catch{return d}};
let products=read('products',seed),sales=read('sales',[]),movements=read('movements',[]),opening=read('opening',200),cashOpen=read('cashOpen',true),cart={},discount=0,saleNo=read('saleNo',1),movementType='suprimento',filter='Todos',lastReceipt='';
const money=n=>Number(n||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const save=()=>{localStorage.setItem('gestorpdv_products',JSON.stringify(products));localStorage.setItem('gestorpdv_sales',JSON.stringify(sales));localStorage.setItem('gestorpdv_movements',JSON.stringify(movements));localStorage.setItem('gestorpdv_opening',JSON.stringify(opening));localStorage.setItem('gestorpdv_cashOpen',JSON.stringify(cashOpen));localStorage.setItem('gestorpdv_saleNo',JSON.stringify(saleNo))};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function toast(t){const e=document.getElementById('toast');e.textContent=t;e.classList.add('show');clearTimeout(window._toast);window._toast=setTimeout(()=>e.classList.remove('show'),2200)}
function iconFor(cat){return ({Mercearia:['ME',''],Bebidas:['BE','orange'],Higiene:['HI','green'],Limpeza:['LI','purple'],Frios:['FR','orange']})[cat]||[String(cat).slice(0,2).toUpperCase(),'']}
function categories(){const cats=['Todos',...new Set(products.map(p=>p.category))];document.getElementById('filters').innerHTML=cats.map(c=>`<button class="filter ${filter===c?'active':''}" onclick="setFilter('${esc(c).replace(/'/g,"\\'")}')">${esc(c)}</button>`).join('')}
function setFilter(c){filter=c;categories();renderProducts()}
function renderProducts(){categories();const q=document.getElementById('search').value.toLowerCase();const list=products.filter(p=>(filter==='Todos'||p.category===filter)&&(p.name.toLowerCase().includes(q)||p.code.toLowerCase().includes(q)));document.getElementById('catalogCount').textContent=products.length+' produtos cadastrados';document.getElementById('productGrid').innerHTML=list.length?list.map(p=>{const [ic,cl]=iconFor(p.category);return `<button class="product" ${p.stock<=0?'disabled':''} onclick="addToCart(${p.id})"><div class="prod-top"><span class="prod-code">${esc(p.code.slice(-6))}</span><span class="prod-icon ${cl}">${ic}</span></div><div class="prod-name">${esc(p.name)}</div><div class="prod-meta">${esc(p.category)} · ${p.stock} un.</div><div class="prod-bottom"><span class="prod-price">${money(p.price)}</span><span class="plus">+</span></div></button>`}).join(''):'<div class="empty-cart" style="grid-column:1/-1">Nenhum produto encontrado.</div>'}
function addToCart(id){if(!cashOpen){toast('Caixa encerrado. Abra um novo caixa para vender.');return}const p=products.find(x=>x.id===id);if(!p||p.stock<=(cart[id]?.qty||0)){toast('Estoque insuficiente.');return}cart[id]?cart[id].qty++:cart[id]={...p,qty:1};renderCart()}
function changeQty(id,n){const it=cart[id];if(!it)return;it.qty+=n;if(it.qty<=0)delete cart[id];else if(it.qty>products.find(p=>p.id===id).stock){it.qty=products.find(p=>p.id===id).stock;toast('Limite de estoque atingido.')}renderCart()}
function calc(){const items=Object.values(cart),sub=items.reduce((a,p)=>a+p.price*p.qty,0),off=sub*discount/100;return {items,sub,off,total:sub-off,count:items.reduce((a,p)=>a+p.qty,0)}}
function renderCart(){const c=calc();document.getElementById('itemCount').textContent=c.count+' '+(c.count===1?'ITEM':'ITENS');document.getElementById('cartList').innerHTML=c.items.length?c.items.map(p=>`<div class="cart-row"><div><div class="cart-prod">${esc(p.name)}</div><div class="cart-unit">${money(p.price)} / unidade</div><div class="cart-actions"><button class="qty-btn" onclick="changeQty(${p.id},-1)">−</button><span class="qty-num">${p.qty}</span><button class="qty-btn" onclick="changeQty(${p.id},1)">+</button><button class="remove" title="Remover" onclick="changeQty(${p.id},-${p.qty})">×</button></div></div><div class="cart-price">${money(p.price*p.qty)}</div></div>`).join(''):'<div class="empty-cart"><div><span>＋</span>Carrinho vazio<br>Selecione produtos no catálogo.</div></div>';document.getElementById('subtotal').textContent=money(c.sub);document.getElementById('discountAmount').textContent='− '+money(c.off);document.getElementById('grandTotal').textContent=money(c.total);document.getElementById('checkoutBtn').disabled=!c.count||!cashOpen}
function setDiscount(){const v=Number(document.getElementById('discountInput').value);if(!Number.isFinite(v)||v<0||v>100){toast('Desconto deve estar entre 0 e 100%.');return}discount=v;renderCart();toast('Desconto aplicado.')}
function openPayment(){if(!calc().count)return;document.getElementById('paymentTotal').textContent=money(calc().total);document.getElementById('paymentMethod').value='PIX';document.getElementById('cashReceived').value='';paymentMethodChanged();show('paymentModal')}
function paymentMethodChanged(){const cash=document.getElementById('paymentMethod').value==='Dinheiro';document.getElementById('cashReceivedWrap').style.display=cash?'block':'none';updateChange()}
function updateChange(){const v=Number(document.getElementById('cashReceived').value)||0;document.getElementById('changeValue').textContent=money(Math.max(0,v-calc().total))}
function confirmSale(){const c=calc(),method=document.getElementById('paymentMethod').value,received=Number(document.getElementById('cashReceived').value)||0;if(!c.count)return;if(!cashOpen){toast('Caixa encerrado.');return}if(method==='Dinheiro'&&received<c.total){toast('Valor recebido é menor que o total.');return}for(const item of c.items){const p=products.find(x=>x.id===item.id);if(!p||p.stock<item.qty){toast('Estoque insuficiente para '+item.name);return}}
const now=new Date(),sale={number:saleNo++,date:now.toISOString(),customer:document.getElementById('customer').value.trim()||'Consumidor não identificado',method,items:c.items.map(({id,code,name,price,qty})=>({id,code,name,price,qty})),subtotal:c.sub,discount,discountValue:c.off,total:c.total,received:method==='Dinheiro'?received:c.total,change:method==='Dinheiro'?received-c.total:0};c.items.forEach(i=>products.find(p=>p.id===i.id).stock-=i.qty);sales.unshift(sale);save();hide('paymentModal');cart={};discount=0;document.getElementById('discountInput').value='';document.getElementById('customer').value='';document.getElementById('saleCode').textContent='#'+String(saleNo).padStart(4,'0');lastReceipt=receiptHTML(sale);document.getElementById('receiptContent').innerHTML=lastReceipt;show('receiptModal');renderAll()}
function receiptHTML(s){return `<div style="text-align:center;font-weight:800;letter-spacing:1px">GESTOR PDV · COMPROVANTE</div><div style="text-align:center;color:#7d8796">Loja Matriz · Caixa 01</div><hr>Venda: #${String(s.number).padStart(4,'0')}<br>Data: ${new Date(s.date).toLocaleString('pt-BR')}<br>Cliente: ${esc(s.customer)}<hr>${s.items.map(i=>`${i.qty}x ${esc(i.name)} — ${money(i.price*i.qty)}`).join('<br>')}<hr>Subtotal: ${money(s.subtotal)}<br>Desconto (${s.discount}%): − ${money(s.discountValue)}<br>Pagamento: ${esc(s.method)}<br><b style="font-size:15px">TOTAL: ${money(s.total)}</b>${s.method==='Dinheiro'?`<br>Recebido: ${money(s.received)}<br>Troco: ${money(s.change)}`:''}<hr><div style="text-align:center">Obrigado pela preferência!</div>`}
function printReceipt(){const w=window.open('','_blank','width=420,height=650');if(!w){toast('Permita pop-ups para imprimir.');return}w.document.write(`<html><head><title>Comprovante GESTOR PDV</title><style>body{font:12px Arial;padding:24px;max-width:340px;margin:auto;color:#111}hr{border:0;border-top:1px dashed #aaa;margin:12px 0}</style></head><body>${lastReceipt}</body></html>`);w.document.close();w.focus();w.print()}
function newCurrentSale(){if(Object.keys(cart).length&&!confirm('Descartar os itens desta venda e iniciar outra?'))return;cart={};discount=0;document.getElementById('discountInput').value='';document.getElementById('customer').value='';renderCart();toast('Nova venda iniciada.')}
function show(id){document.getElementById(id).classList.add('open')}function hide(id){document.getElementById(id).classList.remove('open')}function closePayment(){hide('paymentModal')}function closeReceipt(){hide('receiptModal')}
function renderStats(){const revenue=sales.reduce((a,s)=>a+s.total,0),count=sales.length,units=products.reduce((a,p)=>a+p.stock,0);document.getElementById('statRevenue').textContent=money(revenue);document.getElementById('statCount').textContent=count;document.getElementById('statTicket').textContent=money(count?revenue/count:0);document.getElementById('statStock').textContent=units;document.getElementById('historyRevenue').textContent=money(revenue);document.getElementById('historyCount').textContent=count;document.getElementById('stockProducts').textContent=products.length;document.getElementById('stockUnits').textContent=units;document.getElementById('stockLow').textContent=products.filter(p=>p.stock<=5).length}
function renderSales(){const q=(document.getElementById('salesSearch')?.value||'').toLowerCase();const list=sales.filter(s=>String(s.number).includes(q)||s.customer.toLowerCase().includes(q)||s.method.toLowerCase().includes(q));document.getElementById('salesBody').innerHTML=list.length?list.map(s=>`<tr><td><b>#${String(s.number).padStart(4,'0')}</b></td><td>${new Date(s.date).toLocaleString('pt-BR')}</td><td>${esc(s.customer)}</td><td>${esc(s.method)}</td><td>${s.items.reduce((a,i)=>a+i.qty,0)}</td><td><b>${money(s.total)}</b></td><td><span class="pill">Concluída</span></td></tr>`).join(''):'<tr><td colspan="7" style="text-align:center;color:#8b96a6;padding:30px">Nenhuma venda registrada.</td></tr>'}
function renderStock(){const q=(document.getElementById('stockSearch')?.value||'').toLowerCase();const list=products.filter(p=>(p.name+' '+p.code+' '+p.category).toLowerCase().includes(q));document.getElementById('stockBody').innerHTML=list.map(p=>`<tr><td>${esc(p.code)}</td><td><b>${esc(p.name)}</b></td><td>${esc(p.category)}</td><td>${money(p.price)}</td><td><span class="${p.stock<=5?'pill':' '}" style="${p.stock<=5?'background:#fff2e4;color:#a86d20':''}">${p.stock} un.</span></td><td><button class="btn" style="padding:6px 9px" onclick="editProduct(${p.id})">Editar</button> <button class="btn btn-danger" style="padding:6px 9px" onclick="deleteProduct(${p.id})">Excluir</button></td></tr>`).join('')||'<tr><td colspan="6">Nenhum produto encontrado.</td></tr>'}
function renderCash(){const cash=sales.filter(s=>s.method==='Dinheiro').reduce((a,s)=>a+s.total,0),moves=movements.reduce((a,m)=>a+(m.type==='suprimento'?m.amount:-m.amount),0);document.getElementById('openingValue').textContent=money(opening);document.getElementById('cashSales').textContent=money(cash);document.getElementById('expectedCash').textContent=money(opening+cash+moves);document.getElementById('cashStatus').textContent=cashOpen?'CAIXA ABERTO':'CAIXA ENCERRADO';document.getElementById('cashStatus').style.background=cashOpen?'#e9f6f0':'#fff2e4';document.getElementById('movementsBody').innerHTML=movements.map(m=>`<tr><td>${new Date(m.date).toLocaleString('pt-BR')}</td><td>${m.type==='suprimento'?'Suprimento':'Sangria'}</td><td>${esc(m.description)}</td><td>${money(m.amount)}</td></tr>`).join('')||'<tr><td colspan="4" style="text-align:center">Nenhuma movimentação registrada.</td></tr>'}
function renderAll(){renderStats();renderProducts();renderCart();renderSales();renderStock();renderCash()}
function switchView(v){document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));document.getElementById('view-'+v).classList.add('active');document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.view===v));document.getElementById('crumb').textContent=({pdv:'Frente de caixa',sales:'Vendas realizadas',stock:'Produtos e estoque',cash:'Movimentação de caixa'})[v];renderAll()}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>switchView(b.dataset.view)));
function focusSearch(){switchView('pdv');document.getElementById('search').focus()}
function openProductModal(p){document.getElementById('productModalTitle').textContent=p?'Editar produto':'Cadastrar produto';document.getElementById('editProductId').value=p?.id||'';document.getElementById('newName').value=p?.name||'';document.getElementById('newCode').value=p?.code||'';document.getElementById('newCategory').value=p?.category||'';document.getElementById('newPrice').value=p?.price??'';document.getElementById('newStock').value=p?.stock??'';show('productModal')}
function editProduct(id){openProductModal(products.find(p=>p.id===id))}
function closeProductModal(){hide('productModal')}
function saveProduct(){const id=Number(document.getElementById('editProductId').value),name=document.getElementById('newName').value.trim(),code=document.getElementById('newCode').value.trim(),category=document.getElementById('newCategory').value.trim(),price=Number(document.getElementById('newPrice').value),stock=Number(document.getElementById('newStock').value);if(!name||!code||!category||!Number.isFinite(price)||price<0||!Number.isInteger(stock)||stock<0){toast('Preencha os campos corretamente.');return}if(products.some(p=>p.code===code&&p.id!==id)){toast('Já existe um produto com esse código.');return}if(id){Object.assign(products.find(p=>p.id===id),{name,code,category,price,stock})}else{products.push({id:Math.max(0,...products.map(p=>p.id))+1,name,code,category,price,stock})}save();hide('productModal');renderAll();toast('Produto salvo com sucesso.')}
function deleteProduct(id){const p=products.find(x=>x.id===id);if(!confirm(`Excluir "${p.name}" do catálogo?`))return;products=products.filter(x=>x.id!==id);delete cart[id];save();renderAll();toast('Produto excluído.')}
function cashMovement(type){movementType=type;document.getElementById('movementTitle').textContent=type==='suprimento'?'Registrar suprimento':'Registrar sangria';document.getElementById('movementAmount').value='';document.getElementById('movementDescription').value='';show('movementModal')}
function saveMovement(){const amount=Number(document.getElementById('movementAmount').value),description=document.getElementById('movementDescription').value.trim();if(!Number.isFinite(amount)||amount<=0||!description){toast('Informe valor e descrição.');return}if(movementType==='sangria'){const balance=opening+sales.filter(s=>s.method==='Dinheiro').reduce((a,s)=>a+s.total,0)+movements.reduce((a,m)=>a+(m.type==='suprimento'?m.amount:-m.amount),0);if(amount>balance){toast('Sangria maior que o saldo esperado.');return}}movements.unshift({type:movementType,amount,description,date:new Date().toISOString()});save();hide('movementModal');renderCash();toast('Movimentação registrada.')}
function closeCash(){if(!cashOpen){if(confirm('Abrir um novo caixa com saldo inicial de R$ 200,00?')){opening=200;cashOpen=true;save();renderCash();toast('Novo caixa aberto.')}return}const cash=sales.filter(s=>s.method==='Dinheiro').reduce((a,s)=>a+s.total,0),moves=movements.reduce((a,m)=>a+(m.type==='suprimento'?m.amount:-m.amount),0),expected=opening+cash+moves;if(!confirm('Encerrar o caixa? Saldo esperado: '+money(expected)+'.'))return;cashOpen=false;save();renderCash();toast('Caixa encerrado.')}
function exportSales(){if(!sales.length){toast('Ainda não há vendas para exportar.');return}const rows=[['Venda','Data','Cliente','Pagamento','Itens','Subtotal','Desconto','Total'],...sales.map(s=>[s.number,new Date(s.date).toLocaleString('pt-BR'),s.customer,s.method,s.items.reduce((a,i)=>a+i.qty,0),s.subtotal,s.discountValue,s.total])];const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')).join('\n'),blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='relatorio_vendas_orbita.csv';a.click();URL.revokeObjectURL(url)}
document.getElementById('search').addEventListener('input',renderProducts);
