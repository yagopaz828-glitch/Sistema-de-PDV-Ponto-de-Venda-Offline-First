   <div class="stats"><div class="stat"><div class="stat-top">TOTAL VENDIDO</div><strong id="historyRevenue">R$ 0,00</strong><small>Vendas registradas neste navegador</small></div><div class="stat"><div class="stat-top">TRANSAÇÕES</div><strong id="historyCount">0</strong><small>Comprovantes emitidos</small></div></div>
