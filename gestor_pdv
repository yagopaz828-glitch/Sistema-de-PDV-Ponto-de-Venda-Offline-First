<body>
<div class="shell">
<aside class="sidebar">
 <div class="logo"><div class="logo-mark">O</div><div><div class="logo-name">GESTOR PDV</div><div class="logo-sub">SISTEMA COMERCIAL</div></div></div>
 <div class="nav-label">OPERAÇÃO</div>
 <nav class="nav">
  <button class="active" data-view="pdv"><span class="nav-icon">▦</span><span class="nav-text">Frente de caixa</span></button>
  <button data-view="sales"><span class="nav-icon">↗</span><span class="nav-text">Vendas realizadas</span></button>
  <button data-view="stock"><span class="nav-icon">▤</span><span class="nav-text">Produtos e estoque</span></button>
  <button data-view="cash"><span class="nav-icon">▣</span><span class="nav-text">Movimentação de caixa</span></button>
 </nav>
 <div class="sidebar-bottom"><div class="nav-label">UNIDADE ATUAL</div><div class="store-card"><div class="store-line"><i class="store-dot"></i><strong>Loja Matriz · Caixa 01</strong></div><small>Operador: Administrador</small></div></div>
</aside>
<main>
 <header class="topbar"><div class="crumb">GESTOR PDV / <b id="crumb">Frente de caixa</b></div><div class="top-right"><div class="live">Sistema operacional</div><div class="operator"><div class="avatar">AD</div><div><b>Administrador</b><small>Operador do caixa</small></div></div></div></header>
 <div class="content">
  <section class="view active" id="view-pdv">
   <div class="page-head"><div><div class="kicker">PONTO DE VENDA · LOJA MATRIZ</div><h1>Frente de caixa</h1></div><div class="head-actions"><button class="btn" onclick="focusSearch()">⌕ &nbsp; Buscar <span style="color:#9aa3b2">F2</span></button><button class="btn btn-primary" onclick="newCurrentSale()">＋ Nova venda</button></div></div>
   <div class="stats">
    <div class="stat"><div class="stat-top">VENDAS DO DIA <i class="stat-symbol">↗</i></div><strong id="statRevenue">R$ 0,00</strong><small class="positive">Total confirmado hoje</small></div>
    <div class="stat"><div class="stat-top">QUANTIDADE DE VENDAS <i class="stat-symbol">▤</i></div><strong id="statCount">0</strong><small>Transações finalizadas</small></div>
    <div class="stat"><div class="stat-top">TICKET MÉDIO <i class="stat-symbol">◉</i></div><strong id="statTicket">R$ 0,00</strong><small>Valor médio por venda</small></div>
    <div class="stat"><div class="stat-top">ITENS NO ESTOQUE <i class="stat-symbol">▦</i></div><strong id="statStock">0</strong><small>Unidades disponíveis</small></div>
   </div>
   <div class="pos-layout">
    <section class="catalog"><div class="catalog-head"><h2>Catálogo de produtos</h2><span id="catalogCount">0 itens cadastrados</span></div>
     <div class="searchbar"><div class="searchbox"><i>⌕</i><input id="search" placeholder="Nome do produto ou código de barras..." autocomplete="off"></div><button class="btn scan" onclick="focusSearch()">▥ &nbsp; Código</button></div>
     <div class="filters" id="filters"></div><div class="product-grid" id="productGrid"></div>
    </section>
    <aside class="sale-panel">
     <div class="sale-head"><div class="sale-title"><h2>Venda em andamento</h2></div><span class="sale-code" id="saleCode">#0001</span></div>
     <div class="customer"><label class="field-label">CLIENTE (OPCIONAL)</label><input class="field" id="customer" placeholder="Nome ou CPF do cliente"></div>
     <div class="cart-head"><b>Itens da venda</b><span class="count" id="itemCount">0 ITENS</span></div>
     <div class="cart-list" id="cartList"></div>
     <div class="totals">
      <div class="total-row"><span>Subtotal</span><b id="subtotal">R$ 0,00</b></div>
      <div class="discount-line"><input id="discountInput" type="number" min="0" max="100" step=".5" placeholder="Desconto (%)"><button onclick="setDiscount()">APLICAR</button></div>
      <div class="total-row"><span>Desconto aplicado</span><b id="discountAmount">R$ 0,00</b></div>
      <div class="grand"><span>TOTAL A PAGAR</span><strong id="grandTotal">R$ 0,00</strong></div>
      <button class="checkout-btn" id="checkoutBtn" disabled onclick="openPayment()">RECEBER PAGAMENTO &nbsp; →</button>
      <div class="shortcut">F2 Buscar produto &nbsp;·&nbsp; F4 Receber pagamento &nbsp;·&nbsp; Esc Fechar janela</div>
     </div>
    </aside>
   </div>
  </section>
  <section class="view" id="view-sales">
